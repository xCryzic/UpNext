APP_ENV=development
SECRET_KEY=replace-with-a-long-random-value
# Relative paths resolve from backend/, so this is backend/data/upnext.db.
DATABASE_PATH=data/upnext.db
FRONTEND_URL=http://localhost:5173
ADMIN_EMAILS=
RATE_LIMIT_ENABLED=1
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_SIGNUP_PER_MINUTE=5
RATE_LIMIT_REPORTS_PER_MINUTE=5
RATE_LIMIT_OAUTH_PER_MINUTE=10

# GitHub OAuth App credentials. Never commit backend/.env or a real secret.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:5000/api/creator/socials/github/callback

# Spotify OAuth App credentials. Spotify local HTTP callbacks must use 127.0.0.1, not localhost.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_OAUTH_CALLBACK_URL=http://127.0.0.1:5000/api/creator/socials/spotify/callback
