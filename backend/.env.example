# GitHub OAuth App credentials. Never commit backend/.env or a real secret.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:5000/api/creator/socials/github/callback

# Spotify OAuth App credentials. Spotify local HTTP callbacks must use 127.0.0.1, not localhost.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_OAUTH_CALLBACK_URL=http://127.0.0.1:5000/api/creator/socials/spotify/callback
